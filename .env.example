# Backend environment selection
APP_ENV=development
APP_NAME=subscription-system-api
API_HOST=127.0.0.1
API_PORT=8000

# Local-only persistence
LOCAL_DATABASE_PATH=./data/development.sqlite3
LOCAL_FILE_STORAGE_PATH=./data/files
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_SECRET=change-this-development-secret
PAYMENT_PROVIDER=local
SECRETS_MANAGER_SECRET_NAME=subscription-system/development/application
SECRETS_MANAGER_ENABLED=false

# Development usa un simulador de pago integrado. PayPal Sandbox solo se activa
# explícitamente con PAYMENT_PROVIDER=paypal. No subir valores reales.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASIC_PLAN_ID=
# PAYPAL_PREMIUM_PLAN_ID=P-14A982422Y768161NNLWGKLY
# PAYPAL_RETURN_URL=http://127.0.0.1:8000/checkout/paypal/return
# PAYPAL_CANCEL_URL=http://127.0.0.1:8000/checkout/paypal/cancel
# En integration/production estos valores deben vivir en Secrets Manager.
# Integration usa PayPal Sandbox; production usa https://api-m.paypal.com.

# Prueba local de integration con PayPal Sandbox:
# APP_ENV=integration
# LOCAL_DATABASE_PATH=./data/integration.sqlite3
# LOCAL_FILE_STORAGE_PATH=./data/integration-files
# LOCAL_AUTH_ENABLED=true
# PAYMENT_PROVIDER=paypal
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# SECRETS_MANAGER_ENABLED=false

# Frontend build-time environment variables
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_BACKOFFICE_ENABLED=true

# Integration/production values are injected by the deployment system.
# Do not put PayPal, Cognito or AWS secrets in this file.
